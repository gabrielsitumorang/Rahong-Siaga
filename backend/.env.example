# ============================================================
# Flood Early Warning System - Environment Configuration
# Sistem Peringatan Dini Banjir Desa Rahong
# ============================================================

# OpenWeatherMap API Key (dapatkan di https://openweathermap.org/api)
OWM_API_KEY=your_openweathermap_api_key_here

# Firebase Cloud Messaging credentials JSON path
FCM_CREDENTIALS_PATH=path/to/firebase-service-account.json

# Koordinat Desa Rahong (latitude & longitude)
DESA_RAHONG_LAT=-6.8500
DESA_RAHONG_LON=106.7500

# Interval pengambilan data cuaca (dalam menit)
FETCH_INTERVAL_MINUTES=10

# Debug mode (true/false)
DEBUG=true
